# Copy to backend/.env (or export these in your shell) to override defaults.
# Everything here has a sensible local-dev default — see backend/app/core/config.py

# --- Database ---
DATABASE_URL=sqlite:///./data/sanraksha.db

# --- IMD / satellite data source ---
# true = use realistic mock data (default, works with zero setup)
# false = call the real IMD API (requires IMD_API_BASE_URL + IMD_API_KEY)
USE_MOCK_IMD=true
IMD_API_BASE_URL=https://mausam.imd.gov.in/api
IMD_API_KEY=

# --- Copernicus Sentinel imagery ---
# Create an OAuth client in Copernicus Data Space / Sentinel Hub.
# Never commit real credentials.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
SATELLITE_LOOKBACK_DAYS=30
SATELLITE_MAX_CLOUD_COVER_PCT=80
SATELLITE_AOI_RADIUS_DEG=0.04
SATELLITE_IMAGE_WIDTH=768
SATELLITE_IMAGE_HEIGHT=512
SATELLITE_CACHE_SECONDS=600

# --- ML model ---
TRAINED_MODEL_PATH=../ml/models/landslide_model.pkl

# --- Background sync scheduler ---
ENABLE_SCHEDULER=false
SYNC_INTERVAL_MINUTES=30

# --- MQTT / IoT ingest ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=sanraksha/sensors
INGEST_TOKEN=dev-ingest-token

# --- Used by iot/gateway/gateway.py ---
BACKEND_URL=http://localhost:8000
